# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Auth — comma-separated Slack user IDs allowed to use the bot
ALLOWED_USERS=U0B1FJ73MRM

# --- opencode auth ---
# The key opencode wrote when you ran `opencode auth login`. Extract it from
# your host with:
#   jq -r '."opencode-go".key' ~/.local/share/opencode/auth.json
# Entrypoint materializes auth.json from this on container start.
OPENCODE_API_KEY=

# --- Repos (Docker mode) ---
# Comma-separated git URLs. The container clones each into /workspace/<name>
# at startup and auto-fills ALLOWED_REPOS / DEFAULT_REPO from them.
GIT_REPOS=https://github.com/yourname/yourrepo
# Personal access token used for clone + push. Stays in env only — never
# written into ~/.gitconfig or repo configs.
GITHUB_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- Repos (non-Docker / explicit override) ---
# Set these only when running outside Docker, or to override the auto-derived
# values above. Must be absolute paths that exist on the bot host.
# ALLOWED_REPOS=/root/projects/<project-name>
# DEFAULT_REPO=/root/projects/<project-name>
# OPENCODE_BIN=/root/.opencode/bin/opencode
# DATA_DIR=./data

DEFAULT_AGENT=general
LOG_LEVEL=info
MAX_COST_PER_SESSION_USD=1.00
