# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Auth (Decisions §5, §4) — comma-separated
ALLOWED_USERS=U0B1FJ73MRM
ALLOWED_REPOS=/root/projects/<project-name>

# OpenCode
OPENCODE_BIN=/root/.opencode/bin/opencode
DEFAULT_REPO=/root/projects/<project-name>
DEFAULT_AGENT=general

# Storage
DATA_DIR=./data

# Logging
LOG_LEVEL=info

# Limits
MAX_COST_PER_SESSION_USD=1.00
