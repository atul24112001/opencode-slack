[Unit]
Description=OpenCode Slack Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode-bot
Group=opencode-bot
WorkingDirectory=/opt/opencode-slack-bot

# .env-style file with SLACK_*, ALLOWED_*, OPENCODE_BIN, DATA_DIR, etc.
# DATA_DIR must be an absolute writable path (e.g. /var/lib/opencode-slack-bot).
EnvironmentFile=/etc/opencode-slack-bot.env

ExecStart=/usr/bin/node dist/index.js

# Restart on crash but back off to avoid tight loops
Restart=on-failure
RestartSec=5

# Send SIGTERM, then SIGKILL after 10s if still alive
KillSignal=SIGTERM
TimeoutStopSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opencode-slack-bot

# Light hardening only. We deliberately do NOT use ProtectHome / ProtectSystem
# because opencode runs against repos under the user's filesystem (often /root,
# /home, or anywhere ALLOWED_REPOS points to), and those flags would block it.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
